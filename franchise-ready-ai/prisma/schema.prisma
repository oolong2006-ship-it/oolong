generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  draft
  data_completed
  ai_generated
  preview_ready
  final_issued
  locked
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  mobile        String?
  password      String
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  payments         Payment[]
  projectCredits   ProjectCredit[]
  establishments   Establishment[]
  sessions         Session[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Float
  currency        String        @default("SAR")
  vatAmount       Float         @default(0)
  totalAmount     Float
  status          PaymentStatus @default(pending)
  provider        String?
  providerRef     String?
  providerPayload Json?
  description     String?
  creditGranted   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  projectCredit ProjectCredit?

  @@map("payments")
}

model ProjectCredit {
  id        String   @id @default(cuid())
  userId    String
  paymentId String?  @unique
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  payment       Payment?       @relation(fields: [paymentId], references: [id])
  establishment Establishment?

  @@map("project_credits")
}

model Establishment {
  id            String        @id @default(cuid())
  userId        String
  creditId      String?       @unique
  status        ProjectStatus @default(draft)
  dataCompletion Int          @default(0)
  lockedAt      DateTime?
  finalIssuedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // General Info
  nameAr          String?
  nameEn          String?
  activityType    String?
  city            String?
  country         String      @default("SA")
  foundingYear    Int?
  branchCount     Int?
  fullyOwned      Boolean?
  trademarkReg    Boolean?
  crNumber        String?
  descriptionAr   String?

  // Identity
  websiteUrl      String?
  instagramUrl    String?
  brandColors     String?

  // Products & Services
  mainProducts        String?
  bestSeller          String?
  avgPrice            Float?
  uniquePoints        String?
  hasDocRecipes       Boolean?
  qualityReplicable   Boolean?

  // Market
  targetCustomer      String?
  competitors         String?
  expansionCities     String?
  demandStrength      String?
  seasonality         String?

  // Financials
  avgMonthlySales     Float?
  avgDailyOrders      Int?
  avgInvoiceValue     Float?
  cogs                Float?
  rent                Float?
  salaries            Float?
  opExpenses          Float?
  netProfit           Float?
  newBranchCost       Float?
  paybackPeriod       String?

  // Operations
  hasSOPs             Boolean?
  hasPOS              Boolean?
  hasERP              Boolean?
  hasOpsManual        Boolean?
  hasTrainingManual   Boolean?
  qualityControl      String?
  complaintProcess    String?
  hasInternalAudit    Boolean?

  // HR
  employeesPerBranch  Int?
  orgStructure        String?
  trainingDuration    String?
  hasInternalTrainer  Boolean?
  easyToReplicate     Boolean?

  // Supply Chain
  mainSuppliers       String?
  hasSupplierContracts Boolean?
  hasMaterialSpecs    Boolean?
  hasCentralKitchen   Boolean?
  hasCentralWarehouse Boolean?
  canMandateSuppliers Boolean?

  // Franchise Intent
  franchiseWhy        String?
  targetBranchCount   Int?
  expansionScope      String?
  proposedFees        Float?
  proposedRoyalty     Float?
  franchiseeSupport   String?

  user          User             @relation(fields: [userId], references: [id])
  credit        ProjectCredit?   @relation(fields: [creditId], references: [id])
  uploadedFiles UploadedFile[]
  answers       QuestionnaireAnswer[]
  aiResults     AiAnalysisResult[]
  reports       GeneratedReport[]

  @@map("establishments")
}

model UploadedFile {
  id              String   @id @default(cuid())
  establishmentId String
  fileType        String
  fileName        String
  fileSize        Int
  mimeType        String
  storagePath     String
  publicUrl       String?
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@map("uploaded_files")
}

model QuestionnaireAnswer {
  id              String   @id @default(cuid())
  establishmentId String
  section         String
  questionKey     String
  answerValue     String?
  answerJson      Json?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, section, questionKey])
  @@map("questionnaire_answers")
}

model AiAnalysisResult {
  id              String   @id @default(cuid())
  establishmentId String
  sectionKey      String
  prompt          String?  @db.Text
  rawOutput       String?  @db.Text
  parsedOutput    Json?
  model           String?
  tokensUsed      Int?
  generatedAt     DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, sectionKey])
  @@map("ai_analysis_results")
}

model GeneratedReport {
  id              String   @id @default(cuid())
  establishmentId String
  version         Int      @default(1)
  isFinal         Boolean  @default(false)
  storagePath     String?
  publicUrl       String?
  readinessScore  Int?
  brandStrength   Int?
  replicability   Int?
  productClarity  Int?
  unitEconomics   Int?
  systemsSOPs     Int?
  supplyChain     Int?
  legalReadiness  Int?
  generatedAt     DateTime @default(now())

  establishment  Establishment   @relation(fields: [establishmentId], references: [id])
  sections       ReportSection[]

  @@map("generated_reports")
}

model ReportSection {
  id        String   @id @default(cuid())
  reportId  String
  sectionKey String
  titleAr   String?
  content   String?  @db.Text
  contentJson Json?
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  report GeneratedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_sections")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/franchise_ready_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Payment ──────────────────────────────────────────────────────────────────
# Options: "mock" | "moyasar"
PAYMENT_PROVIDER=mock

# Moyasar (production)
MOYASAR_API_KEY=sk_live_...

# Product pricing (in SAR, before VAT)
PRODUCT_PRICE_SAR=1500

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: "local" | "supabase"
STORAGE_PROVIDER=local

# Local storage (development)
LOCAL_STORAGE_PATH=./uploads

# Supabase storage (production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=franchise-ready-uploads

# ─── Email (optional, for notifications) ─────────────────────────────────────
# SMTP settings for transactional emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM="فرنشايز ريدي <noreply@yourdomain.com>"

# ─── Admin ────────────────────────────────────────────────────────────────────
# Initial admin seed credentials (used in seed script only)
ADMIN_EMAIL=admin@franchise-ready.ai
ADMIN_PASSWORD=change-this-immediately

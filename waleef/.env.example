# ─────────────────────────────────────────────────────────────
# Waleef environment variables
#
# Supabase is OPTIONAL. If you leave these blank, the app runs fully
# on a local-storage fallback (great for quick user testing). Fill
# them in to enable real persistence/auth.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Future: real AI provider (not used by the mock engine) ──
# Swap the engine in lib/waleefEngine.ts + app/api/chat/route.ts.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
